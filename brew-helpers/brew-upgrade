#!/usr/bin/env bash
set -euo pipefail

if ! command -v brew &>/dev/null; then
    echo "brew not found in PATH — run brew-install first" >&2
    exit 1
fi

gum style \
    --border rounded \
    --border-foreground 212 \
    --padding "0 1" \
    "$(gum style --foreground 212 --bold 'brew upgrade')" \
    "" \
    "Running:" \
    "  • brew update (Homebrew, taps, formula definitions)" \
    "  • brew upgrade (formulae and casks)"

echo

gum spin --spinner dot --title "Updating Homebrew and taps..." -- \
    brew update
gum log --level info "Homebrew and taps are up to date"

gum spin --spinner dot --title "Upgrading formulae and casks..." -- \
    brew upgrade
gum log --level info "Upgrade complete"

echo
gum style --foreground 212 --bold "  Done"
gum log --level info "Run brew-cleanup to remove old versions and run doctor."
