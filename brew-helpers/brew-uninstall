#!/usr/bin/env python3
"""Remove Homebrew using the official uninstaller, only when asked."""

import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

UNINSTALLER_URL = "https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh"
STANDARD_BREW = "/home/linuxbrew/.linuxbrew/bin/brew"


def find_brew():
    found = shutil.which("brew")
    if found:
        return found
    if os.access(STANDARD_BREW, os.X_OK):
        return STANDARD_BREW
    return None


def fetch_script(url):
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "brew-uninstall/1.0"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8")


def run_bash(script):
    env = os.environ.copy()
    env["NONINTERACTIVE"] = "1"
    return subprocess.run(["bash"], input=script, text=True, env=env, check=False).returncode


def main():
    if not find_brew():
        print("brew is not installed.")
        return 0

    if os.geteuid() == 0:
        print("Do not run brew-uninstall as root. Run it as your normal user.", file=sys.stderr)
        return 1

    try:
        answer = input("Uninstall Homebrew and ALL installed formulae/casks? [y/N]: ").strip().lower()
    except EOFError:
        print("Run brew-uninstall from a terminal.", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        return 130

    if answer not in ("y", "yes"):
        print("Skipped.")
        return 0

    try:
        script = fetch_script(UNINSTALLER_URL)
    except (urllib.error.URLError, OSError) as exc:
        print(f"Failed to download the Homebrew uninstaller: {exc}", file=sys.stderr)
        return 1

    rc = run_bash(script)
    if rc != 0:
        print(f"Homebrew uninstaller failed with exit code {rc}.", file=sys.stderr)
        return rc

    print("Done. Homebrew has been removed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
