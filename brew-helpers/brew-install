#!/usr/bin/env python3
"""Install Homebrew using the official installer, only when asked."""

import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

INSTALLER_URL = "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh"
STANDARD_BREW = "/home/linuxbrew/.linuxbrew/bin/brew"


def find_brew():
    found = shutil.which("brew")
    if found:
        return found
    if os.access(STANDARD_BREW, os.X_OK):
        return STANDARD_BREW
    return None


def fetch_script(url):
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "brew-install/1.0"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8")


def run_bash(script):
    env = os.environ.copy()
    env["NONINTERACTIVE"] = "1"
    env["HOMEBREW_NO_ANALYTICS"] = "1"
    return subprocess.run(["bash"], input=script, text=True, env=env, check=False).returncode


def main():
    brew = find_brew()
    if brew:
        print(f"brew is already installed: {brew}")
        return subprocess.run([brew, "--version"], check=False).returncode

    if os.geteuid() == 0:
        print("Do not run brew-install as root. Run it as your normal user.", file=sys.stderr)
        return 1

    try:
        answer = input("Homebrew is not installed. Install it now? [y/N]: ").strip().lower()
    except EOFError:
        print("Run brew-install from a terminal.", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        return 130

    if answer not in ("y", "yes"):
        print("Skipped. Run 'brew-install' anytime.")
        return 0

    try:
        script = fetch_script(INSTALLER_URL)
    except (urllib.error.URLError, OSError) as exc:
        print(f"Failed to download the Homebrew installer: {exc}", file=sys.stderr)
        return 1

    rc = run_bash(script)
    if rc != 0:
        print(f"Homebrew installer failed with exit code {rc}.", file=sys.stderr)
        return rc

    print("Done. Open a new shell to use brew.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
